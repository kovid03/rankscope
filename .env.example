# ═══════════════════════════════════════════════════════════════════════
# RankScope — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change_this_to_a_long_random_string_min_32_chars
APP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── JWT Auth ─────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_this_jwt_secret_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database (PostgreSQL) ─────────────────────────────────────────────
# Local development:
DATABASE_URL=postgresql://rankscope_user:rankscope_pass@localhost:5432/rankscope_db
# Docker development:
# DATABASE_URL=postgresql://rankscope_user:rankscope_pass@db:5432/rankscope_db

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Docker:
# REDIS_URL=redis://redis:6379/0

# ── Celery ───────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── DataForSEO (Primary SERP Provider) ───────────────────────────────
# Sign up at: https://dataforseo.com/
# Sandbox mode is available for testing without real credits.
DATAFORSEO_LOGIN=your_dataforseo_login_here
DATAFORSEO_PASSWORD=your_dataforseo_password_here
DATAFORSEO_SANDBOX=true          # set to false for production requests
DATAFORSEO_MAX_MONTHLY_SPEND_USD=50.00

# ── SerpApi (Optional Secondary Provider) ────────────────────────────
# SERPAPI_KEY=your_serpapi_key_here
# SERPAPI_ENABLED=false

# ── Google APIs ───────────────────────────────────────────────────────
# Google PageSpeed Insights (free, just needs an API key)
# GOOGLE_PAGESPEED_API_KEY=your_google_api_key_here

# Google Search Console (only for domains the user has authorized)
# GOOGLE_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── AI Provider (Optional) ───────────────────────────────────────────
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# AI_ENABLED=false

# ── Backlink Provider (Optional) ─────────────────────────────────────
# DATAFORSEO_BACKLINKS_ENABLED=false

# ── API Rate Limits & Cost Controls ──────────────────────────────────
API_DAILY_SERP_LIMIT=100           # max SERP requests per day
API_MAX_CRAWL_PAGES=200            # max pages per crawl job
API_CRAWL_DELAY_SECONDS=2.0        # politeness delay between crawl requests
API_REQUEST_TIMEOUT_SECONDS=30

# ── Monitoring ────────────────────────────────────────────────────────
# SENTRY_DSN=
